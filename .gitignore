# Composer
/vendor/
composer.phar

# Secretos y entorno
.env
/storage/

# Base de datos SQLite: la base es un archivo local, no se versiona.
# (storage/ ya la cubre con la ruta por defecto; estos patrones
# protegen el caso de apuntar DB_DATABASE a otra carpeta.)
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.sqlite3

# Sistema
*.log
Thumbs.db

# Utilidades locales de desarrollo
# Enumera emails y roles de todos los usuarios: nunca debe subirse al repositorio
# ni quedar en un servidor. Va en .gitignore justamente para que no se cuelgue solo.
listar_usuarios.php