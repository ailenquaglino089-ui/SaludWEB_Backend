# ============================================================
# Variables de entorno - SaludWEB (repositorio_backend)
# ============================================================
# Copia este archivo a ".env" y completá los valores:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux / macOS)
#
# NUNCA subas tu .env al repositorio (ya está en .gitignore).
# Lo que se versiona es este .env.example, sin secretos reales.
#
# ------------------------------------------------------------
# CÓMO SE CARGAN ESTAS VARIABLES
# ------------------------------------------------------------
# El archivo .env lo lee core/Env.php, que se ejecuta al principio
# de core/bootstrap.php (peticiones HTTP) y de db.php (scripts de
# la raíz, como sembrar_datos_demo.php o probar_*.php). Sin ese
# cargador, .env se ignora por completo y manda lo que haya
# escrito en el código.
#
# JERARQUÍA (quién gana):
#   1. Variable real del sistema operativo / del servidor.
#   2. Este archivo .env.
#   3. Valor por defecto escrito en el código.
# Por eso se puede definir una variable suelta en la shell para
# probar algo sin editar el archivo.
#
# FORMATO: CLAVE=valor, una por línea. Las líneas que arrancan
# con # son comentarios. Los valores con espacios van entre
# comillas dobles o simples.
#
# ============================================================
# Ejecutar la API
# ============================================================

# Entorno: development | production
# En development se muestran errores en pantalla y se generan
# secretos de prueba si faltan. En production NO se muestra nada
# y Config::validar() exige que todas las obligatorias estén puestas.
APP_ENV=development

# URL base de esta API, sin barra final. La usan los scripts de
# prueba en línea de comandos (probar_roles_http.php) para saber
# contra qué host pegarle.
#   Con php -S (composer run dev): http://127.0.0.1:8000  (default)
#   Otro host o puerto:            la URL que corresponda
API_BASE=http://127.0.0.1:8000

# Zona horaria de PHP, en formato de la base de datos de zonas IANA.
# Se fija en el código (db.php) para que no dependa del php.ini: muchas
# instalaciones traen Europe/Berlin, que no es la zona del proyecto, y eso
# hacía que PHP y la base manejaran horas distintas.
# Si se deja vacío: America/Argentina/Buenos_Aires
APP_TIMEZONE=America/Argentina/Buenos_Aires

# ============================================================
# Base de datos (SQLite)
# ============================================================
# SQLite NO es un servidor: es una biblioteca que viene incluida con
# PHP y guarda toda la base en UN ARCHIVO. Por eso acá no hay host,
# ni puerto, ni usuario, ni contraseña que configurar: son justamente
# las variables que ya no hacen falta (DB_HOST, DB_PORT, DB_NAME,
# DB_USER, DB_PASS se eliminaron).
#
# DB_DATABASE - ruta del archivo de la base.
#   * Si es relativa, se resuelve contra la raíz del backend.
#   * La carpeta y el archivo se crean solos en el primer request:
#     no hay ningún paso previo de instalación ni de "crear la base".
#   * Si se deja vacío: storage/saludweb.sqlite (el valor de abajo).
#   * Para arrancar de cero: borrá el archivo y el esquema y los
#     datos de ejemplo se vuelven a crear solos.
#
# OJO: no pongas la base dentro de una carpeta servida por el
# servidor web (debe quedar fuera del alcance público). storage/ ya
# está en .gitignore, así que no se sube al repositorio.
DB_DATABASE=storage/saludweb.sqlite

# ============================================================
# Autenticación
# ============================================================
# Secreto de firma de los JWT.
# Generalo con:  php -r "echo bin2hex(random_bytes(48));"
# Debe tener al menos 48 caracteres: con menos no se usa como secreto
# (en desarrollo se firma con storage/secret.key y en producción la
# API se niega a arrancar).
# Cambiarlo invalida todos los tokens emitidos con el anterior.
JWT_SECRET=reemplaza-este-valor-por-un-secreto-real

# Vigencia del access token JWT en segundos.
# 3600 = 1 hora. Valores menores a 1 se ignoran y manda 3600
# (un token que nace vencido hace fallar todo el flujo de login
# con un 401 imposible de entender).
JWT_TTL=3600

# ============================================================
# CORS (quiénes pueden llamar a la API desde el navegador)
# ============================================================
# Orígenes permitidos, separados por coma y SIN espacios.
# Cada valor es esquema + host + puerto, sin barra final.
# En desarrollo: el servidor de Vite y el acceso local.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost,http://127.0.0.1

# ============================================================
# Observabilidad: logs estructurados y trazabilidad
# ============================================================
# Módulo: "Calidad Profesional del Software - Logs y Trazabilidad"
#
# LOG_LEVEL - nivel mínimo que se escribe:
#   DEBUG (detalle de desarrollo) | INFO (evento normal)
#   WARN (anómalo recuperable)     | ERROR (fallo que hay que mirar)
#   Si se deja vacío: DEBUG en desarrollo, INFO en producción.
#
# LOG_DIR - carpeta de los archivos de log. Un archivo por día
#   (saludweb-AAAA-MM-DD.log), una línea JSON por registro.
#   Si se deja vacío: storage/logs (dentro de .gitignore, no se sube).
#   Puede ser una ruta absoluta para guardar los logs fuera del repo.
#
# LOG_SERVICE - nombre del componente emisor, útil cuando varios
#   servicios escriben en el mismo archivo.
LOG_LEVEL=
LOG_DIR=
LOG_SERVICE=saludweb-api

# ============================================================
# SSO (Google / Microsoft Entra ID) - OPCIONAL
# ============================================================
# Sin estas variables el endpoint /api/auth/sso responde 501 (no
# configurado) y la app móvil oculta el botón correspondiente.
#
# Google: "Client ID de aplicación web" de Google Cloud Console.
SSO_GOOGLE_CLIENT_ID=
#
# Microsoft: "Application (client) ID" de una app pública de Entra ID.
SSO_MICROSOFT_CLIENT_ID=
# Tenant de Microsoft: 'common' (cuentas personales y corporativas) o
# un tenant específico (ej: 'contoso.onmicrosoft.com').
SSO_MICROSOFT_TENANT=common

# ============================================================
# Datos para probar roles por HTTP - OPCIONAL (solo desarrollo)
# ============================================================
# Los usa probar_roles_http.php para loguearse contra la API real.
# Si no se definen, ese script usa los valores por defecto de abajo.
# No tienen nada que ver con los usuarios reales de la base.
ROL_TEST_ADMIN_EMAIL=admin@prueba.com
ROL_TEST_ADMIN_PASS=admin123
ROL_TEST_MEDICO_EMAIL=medico@prueba.com
ROL_TEST_MEDICO_PASS=medico123

# DNI que usan algunos scripts de prueba para buscar un paciente.
TEST_DNI=12345678
